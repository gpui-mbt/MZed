 use std::process::Command;
 
 fn main() {
+    println!("cargo:rerun-if-env-changed=MZED_NATIVE_LIB_DIR");
+    let native = match std::env::var("MZED_NATIVE_LIB_DIR") {
+        Ok(native) => native,
+        Err(error) => {
+            eprintln!("MZed derived build requires its pinned native library: {error}");
+            std::process::exit(1);
+        }
+    };
+    println!("cargo:rustc-link-search=native={native}");
+    println!("cargo:rustc-link-lib=static=mzed_native");
