+#[derive(Default)]
+pub(super) struct KeySequenceFence {
+    generation: u64,
+    fail_closed: bool,
+    pressed: HashSet<u32>,
+    quarantined_releases: HashSet<u32>,
+}
+
+// This is a bounded backend resource policy, not a Wayland keycode range.
+const MAX_TRACKED_KEY_SEQUENCES: usize = 256;
+
+pub(super) fn wayland_key_to_xkb_keycode(key: u32, offset: u32) -> Option<u32> {
+    let keycode = key.checked_add(offset)?;
+    (keycode != u32::MAX).then_some(keycode)
+}
+
+pub(super) fn decode_keyboard_enter_keys(bytes: &[u8], offset: u32) -> Option<Vec<u32>> {
+    if bytes.len() % std::mem::size_of::<u32>() != 0
+        || bytes.len() / std::mem::size_of::<u32>() > MAX_TRACKED_KEY_SEQUENCES
+    {
+        return None;
+    }
+
+    bytes
+        .chunks_exact(4)
+        .map(|chunk| {
+            let key = u32::from_ne_bytes(chunk.try_into().ok()?);
+            wayland_key_to_xkb_keycode(key, offset)?;
+            Some(key)
+        })
+        .collect()
+}
+
+pub(super) fn focus_generation_matches(
+    owner_generation: Option<u64>,
+    current_generation: Option<u64>,
+) -> bool {
+    owner_generation.is_some() && owner_generation == current_generation
+}
+
+pub(super) fn try_restore_input_handler<T>(
+    slot: &mut Option<T>,
+    value: T,
+    owner_generation: Option<u64>,
+    current_generation: Option<u64>,
+) -> Result<(), T> {
+    if owner_generation != current_generation || slot.is_some() {
+        return Err(value);
+    }
+    *slot = Some(value);
+    Ok(())
+}
+
+#[derive(Default)]
+pub(super) struct DeferredImeCancelGate {
+    pending: usize,
+    fail_closed: bool,
+}
+
+impl DeferredImeCancelGate {
+    pub fn begin(&mut self) -> bool {
+        if self.fail_closed {
+            return false;
+        }
+        let Some(pending) = self.pending.checked_add(1) else {
+            self.fail_closed = true;
+            return false;
+        };
+        self.pending = pending;
+        true
+    }
+
+    pub fn finish(&mut self) -> bool {
+        if self.fail_closed || self.pending == 0 {
+            self.fail_closed = true;
+            return false;
+        }
+        self.pending -= 1;
+        self.pending == 0
+    }
+
+    pub fn allows_ime(&self) -> bool {
+        !self.fail_closed && self.pending == 0
+    }
+}
+
+#[derive(Default, Debug, PartialEq, Eq)]
+pub(super) struct ImeEditBatch {
+    pub commit: Option<Option<String>>,
+    pub preedit: Option<String>,
+}
+
+impl ImeEditBatch {
+    pub fn record_commit(&mut self, text: Option<String>) {
+        self.commit = Some(text);
+    }
+
+    pub fn record_preedit(&mut self, text: Option<String>) {
+        self.preedit = text;
+    }
+
+    pub fn has_commit_text(&self) -> bool {
+        matches!(self.commit.as_ref(), Some(Some(_)))
+    }
+
+    pub fn should_cancel_composition(&self) -> bool {
+        self.preedit.is_none() && !self.has_commit_text()
+    }
+}
+
+impl KeySequenceFence {
+    pub fn generation(&self) -> u64 {
+        self.generation
+    }
+
+    pub fn fail_closed(&mut self) {
+        self.fail_closed = true;
+        self.quarantined_releases
+            .extend(self.pressed.iter().copied());
+    }
+
+    pub fn key_down(&mut self, keycode: u32) -> bool {
+        if self.fail_closed
+            || self.pressed.contains(&keycode)
+            || self.quarantined_releases.contains(&keycode)
+        {
+            return false;
+        }
+        if self.pressed.len() >= MAX_TRACKED_KEY_SEQUENCES {
+            self.fail_closed = true;
+            self.quarantined_releases
+                .extend(self.pressed.iter().copied());
+            return false;
+        }
+        self.pressed.insert(keycode);
+        true
+    }
+
+    pub fn reconcile_keyboard_enter(
+        &mut self,
+        held_keycodes: impl IntoIterator<Item = u32>,
+    ) -> bool {
+        if self.fail_closed {
+            return false;
+        }
+        let Some(generation) = self.generation.checked_add(1) else {
+            self.fail_closed = true;
+            self.quarantined_releases
+                .extend(self.pressed.iter().copied());
+            return false;
+        };
+        self.generation = generation;
+        self.pressed.clear();
+        self.quarantined_releases.clear();
+
+        for keycode in held_keycodes {
+            if self.pressed.contains(&keycode) {
+                continue;
+            }
+            if self.pressed.len() >= MAX_TRACKED_KEY_SEQUENCES {
+                self.fail_closed = true;
+                self.quarantined_releases
+                    .extend(self.pressed.iter().copied());
+                return false;
+            }
+            self.pressed.insert(keycode);
+            self.quarantined_releases.insert(keycode);
+        }
+        true
+    }
+
+    pub fn quarantine_key(&mut self, keycode: u32) -> bool {
+        if self.fail_closed {
+            return false;
+        }
+        if !self.pressed.contains(&keycode) {
+            if self.pressed.len() >= MAX_TRACKED_KEY_SEQUENCES {
+                self.fail_closed = true;
+                self.quarantined_releases
+                    .extend(self.pressed.iter().copied());
+                return false;
+            }
+            self.pressed.insert(keycode);
+        }
+        self.quarantined_releases.insert(keycode);
+        true
+    }
+
+    pub fn key_up(&mut self, keycode: u32) -> bool {
+        if self.fail_closed || !self.pressed.remove(&keycode) {
+            return false;
+        }
+        !self.quarantined_releases.remove(&keycode)
+    }
+
+    pub fn invalidate_owner(&mut self) -> bool {
+        if self.fail_closed {
+            return false;
+        }
+        let Some(generation) = self.generation.checked_add(1) else {
+            self.fail_closed = true;
+            self.quarantined_releases
+                .extend(self.pressed.iter().copied());
+            return false;
+        };
+        self.generation = generation;
+        self.quarantined_releases
+            .extend(self.pressed.iter().copied());
+        true
+    }
+
+    pub fn accepts_repeat(&self, generation: u64, keycode: u32) -> bool {
+        !self.fail_closed
+            && generation == self.generation
+            && self.pressed.contains(&keycode)
+            && !self.quarantined_releases.contains(&keycode)
+    }
+}
