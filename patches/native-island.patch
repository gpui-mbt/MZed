+enum SingleByteCommitRoute {
+    KeyEvent,
+    TextInput,
+    Drop,
+}
+
+fn single_byte_commit_route(preference: Option<bool>) -> SingleByteCommitRoute {
+    match preference {
+        Some(false) => SingleByteCommitRoute::KeyEvent,
+        Some(true) => SingleByteCommitRoute::TextInput,
+        None => SingleByteCommitRoute::Drop,
+    }
+}
+
+fn key_sequence_owner_is_current(
+    state: &WaylandClientState,
+    window: &WaylandWindowStatePtr,
+    generation: u64,
+    keycode: u32,
+) -> bool {
+    state
+        .keyboard_focused_window
+        .as_ref()
+        .is_some_and(|focused| focused.ptr_eq(window))
+        && state.key_sequences.accepts_repeat(generation, keycode)
+}
+
+fn invalidate_keyboard_owner_input(state: &mut WaylandClientState) {
+    state.ime_candidate = None;
+    state.pre_edit_text = None;
+    state.pending_ime_batch = ImeEditBatch::default();
+    state.composing = false;
+    if let Some(compose) = state.compose_state.as_mut() {
+        compose.reset();
+    }
+    state.repeat.current_id = state.repeat.current_id.saturating_add(1);
+    state.repeat.current_keycode = None;
+    state.key_sequences.invalidate_owner();
+}
