@@ -0,0 +1,839 @@
+use std::collections::HashSet;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) struct ImeOwner<F, I> {
+    pub focus_id: F,
+    pub focus_generation: u64,
+    pub seat_id: I,
+    pub surface_id: I,
+    pub text_input_id: I,
+}
+
+impl<F: Clone, I: Clone> ImeOwner<F, I> {
+    fn scope(&self) -> ImeScope<I> {
+        ImeScope {
+            seat_id: self.seat_id.clone(),
+            surface_id: self.surface_id.clone(),
+            text_input_id: self.text_input_id.clone(),
+        }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) struct ImeScope<I> {
+    pub seat_id: I,
+    pub surface_id: I,
+    pub text_input_id: I,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) enum ImeFenceAction<F, I> {
+    Noop,
+    Enable(ImeOwner<F, I>),
+    DisableAndSync { epoch: u64, scope: ImeScope<I> },
+    FailClosed,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+enum ImeFencePhase<F, I> {
+    Initial,
+    Disabled,
+    Enabled(ImeOwner<F, I>),
+    WaitingForSync {
+        epoch: u64,
+        scope: ImeScope<I>,
+        desired: Option<ImeOwner<F, I>>,
+    },
+    FailClosed,
+}
+
+pub(super) struct ImeOwnerFence<F, I> {
+    epoch: u64,
+    phase: ImeFencePhase<F, I>,
+}
+
+impl<F, I> Default for ImeOwnerFence<F, I> {
+    fn default() -> Self {
+        Self {
+            epoch: 0,
+            phase: ImeFencePhase::Initial,
+        }
+    }
+}
+
+impl<F: Clone + PartialEq, I: Clone + PartialEq> ImeOwnerFence<F, I> {
+    pub fn set_owner(&mut self, owner: Option<ImeOwner<F, I>>) -> ImeFenceAction<F, I> {
+        match self.phase.clone() {
+            ImeFencePhase::FailClosed => ImeFenceAction::Noop,
+            ImeFencePhase::Initial | ImeFencePhase::Disabled => {
+                if let Some(owner) = owner {
+                    self.phase = ImeFencePhase::Enabled(owner.clone());
+                    ImeFenceAction::Enable(owner)
+                } else {
+                    self.phase = ImeFencePhase::Disabled;
+                    ImeFenceAction::Noop
+                }
+            }
+            ImeFencePhase::Enabled(current) => {
+                if owner.as_ref() == Some(&current) {
+                    ImeFenceAction::Noop
+                } else if let Some(owner) = owner {
+                    self.begin_fence(owner.scope(), Some(owner))
+                } else {
+                    self.begin_fence(current.scope(), None)
+                }
+            }
+            ImeFencePhase::WaitingForSync { scope, .. } => {
+                if owner.as_ref().is_some_and(|owner| owner.scope() != scope) {
+                    let owner = owner.unwrap();
+                    self.begin_fence(owner.scope(), Some(owner))
+                } else {
+                    if let ImeFencePhase::WaitingForSync { desired, .. } = &mut self.phase {
+                        *desired = owner;
+                    }
+                    ImeFenceAction::Noop
+                }
+            }
+        }
+    }
+
+    pub fn invalidate(&mut self) -> ImeFenceAction<F, I> {
+        match self.phase.clone() {
+            ImeFencePhase::Initial | ImeFencePhase::Disabled | ImeFencePhase::FailClosed => {
+                ImeFenceAction::Noop
+            }
+            ImeFencePhase::Enabled(owner) => self.begin_fence(owner.scope(), None),
+            ImeFencePhase::WaitingForSync { scope, .. } => self.begin_fence(scope, None),
+        }
+    }
+
+    pub fn rearm(&mut self, owner: ImeOwner<F, I>) -> ImeFenceAction<F, I> {
+        self.begin_fence(owner.scope(), Some(owner))
+    }
+
+    pub fn proxy_recreated(&mut self, scope: ImeScope<I>) -> ImeFenceAction<F, I> {
+        self.begin_fence(scope, None)
+    }
+
+    pub fn proxy_removed(&mut self) -> ImeFenceAction<F, I> {
+        if matches!(self.phase, ImeFencePhase::FailClosed) {
+            return ImeFenceAction::Noop;
+        }
+        let Some(epoch) = self.epoch.checked_add(1) else {
+            self.phase = ImeFencePhase::FailClosed;
+            return ImeFenceAction::FailClosed;
+        };
+        self.epoch = epoch;
+        self.phase = ImeFencePhase::Disabled;
+        ImeFenceAction::Noop
+    }
+
+    pub fn complete_sync(
+        &mut self,
+        epoch: u64,
+        callback_scope: &ImeScope<I>,
+        current_owner: Option<ImeOwner<F, I>>,
+    ) -> ImeFenceAction<F, I> {
+        let ImeFencePhase::WaitingForSync {
+            epoch: pending_epoch,
+            scope,
+            desired,
+        } = self.phase.clone()
+        else {
+            return ImeFenceAction::Noop;
+        };
+
+        if pending_epoch != epoch || scope != *callback_scope {
+            return ImeFenceAction::Noop;
+        }
+
+        self.phase = ImeFencePhase::Disabled;
+        if desired.is_some() && desired == current_owner {
+            let owner = desired.unwrap();
+            self.phase = ImeFencePhase::Enabled(owner.clone());
+            ImeFenceAction::Enable(owner)
+        } else {
+            ImeFenceAction::Noop
+        }
+    }
+
+    pub fn is_enabled_for(&self, owner: &ImeOwner<F, I>) -> bool {
+        matches!(&self.phase, ImeFencePhase::Enabled(active) if active == owner)
+    }
+
+    pub fn desired_owner(&self) -> Option<&ImeOwner<F, I>> {
+        match &self.phase {
+            ImeFencePhase::Enabled(owner) => Some(owner),
+            ImeFencePhase::WaitingForSync { desired, .. } => desired.as_ref(),
+            ImeFencePhase::Initial | ImeFencePhase::Disabled | ImeFencePhase::FailClosed => None,
+        }
+    }
+
+    fn begin_fence(
+        &mut self,
+        scope: ImeScope<I>,
+        desired: Option<ImeOwner<F, I>>,
+    ) -> ImeFenceAction<F, I> {
+        let Some(epoch) = self.epoch.checked_add(1) else {
+            self.phase = ImeFencePhase::FailClosed;
+            return ImeFenceAction::FailClosed;
+        };
+        self.epoch = epoch;
+        self.phase = ImeFencePhase::WaitingForSync {
+            epoch,
+            scope: scope.clone(),
+            desired,
+        };
+        ImeFenceAction::DisableAndSync { epoch, scope }
+    }
+}
+
+pub(super) fn is_current_v3_owner<F: PartialEq, I: PartialEq>(
+    event_proxy: &I,
+    live_proxy: &I,
+    active_surface: Option<&I>,
+    entered_surface: Option<&I>,
+    current_owner: Option<&ImeOwner<F, I>>,
+    enabled_owner: &ImeOwner<F, I>,
+) -> bool {
+    event_proxy == live_proxy
+        && active_surface == Some(&enabled_owner.surface_id)
+        && entered_surface == Some(&enabled_owner.surface_id)
+        && current_owner == Some(enabled_owner)
+        && &enabled_owner.text_input_id == live_proxy
+}
+
+pub(super) fn is_keyboard_focused_surface<I: PartialEq>(
+    window_surface: &I,
+    keyboard_surface: Option<&I>,
+) -> bool {
+    keyboard_surface == Some(window_surface)
+}
