+        assert!(!keys.accepts_repeat(old_generation, 31));
+        assert!(!keys.key_up(30));
+        assert!(!keys.key_down(31));
+        assert!(!keys.key_up(31));
+        assert!(keys.key_down(31));
+        assert!(keys.key_up(31));
+        assert!(keys.key_down(30));
+        assert!(keys.key_up(30));
+    }
+
+    #[test]
+    fn key_sequence_storage_is_bounded_without_assuming_a_protocol_keycode_maximum() {
+        let mut keys = KeySequenceFence::default();
+        for keycode in 0..MAX_TRACKED_KEY_SEQUENCES as u32 {
+            assert!(keys.key_down(keycode));
+        }
+        assert_eq!(keys.pressed.len(), MAX_TRACKED_KEY_SEQUENCES);
+        assert!(!keys.key_down(u32::MAX));
+        assert!(keys.fail_closed);
+        assert!(!keys.key_up(0));
+        assert!(!keys.key_down(0));
+        assert!(keys.pressed.len() <= MAX_TRACKED_KEY_SEQUENCES);
+    }
+
+    #[test]
+    fn keycode_translation_checks_offset_overflow_and_invalid_sentinel() {
+        assert_eq!(wayland_key_to_xkb_keycode(30, 8), Some(38));
+        assert_eq!(
+            wayland_key_to_xkb_keycode(u32::MAX - 9, 8),
+            Some(u32::MAX - 1)
+        );
+        assert_eq!(wayland_key_to_xkb_keycode(u32::MAX - 8, 8), None);
+        assert_eq!(wayland_key_to_xkb_keycode(u32::MAX, 8), None);
+    }
+
+    #[test]
+    fn key_sequence_generation_exhaustion_latches_closed() {
+        let mut keys = KeySequenceFence::default();
+        assert!(keys.key_down(30));
+        keys.generation = u64::MAX;
+        assert!(!keys.invalidate_owner());
+        assert!(!keys.accepts_repeat(u64::MAX, 30));
+        assert!(!keys.key_down(31));
+        assert!(!keys.key_up(30));
+        assert_eq!(keys.pressed.len(), 1);
+    }
+
+    #[test]
+    fn keys_held_at_keyboard_enter_are_quarantined() {
+        let mut keys = KeySequenceFence::default();
+        assert!(keys.quarantine_key(30));
+        assert!(!keys.key_down(30));
+        assert!(!keys.key_up(30));
+        assert!(keys.key_down(31));
+        assert!(keys.key_up(31));
+    }
+
+    #[test]
+    fn generation_exhaustion_latches_fail_closed() {
+        let mut fence = ImeOwnerFence::default();
+        fence.epoch = u64::MAX;
+        let owner = owner(1, 1, 7, 10, 20);
+        assert_eq!(fence.rearm(owner.clone()), ImeFenceAction::FailClosed);
+        assert_eq!(fence.set_owner(Some(owner)), ImeFenceAction::Noop);
+    }
+}
