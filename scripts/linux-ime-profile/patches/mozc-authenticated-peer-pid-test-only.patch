diff --git a/src/ipc/peer_pid_log_test.h b/src/ipc/peer_pid_log_test.h
new file mode 100644
index 0000000..d069c75
--- /dev/null
+++ b/src/ipc/peer_pid_log_test.h
@@ -0,0 +1,40 @@
+// Private, compile-gated peer-PID observation used only by the MZed Linux
+// integration profile. The emitted value is the numeric SO_PEERCRED peer PID.
+
+#ifndef MOZC_IPC_PEER_PID_LOG_TEST_H_
+#define MOZC_IPC_PEER_PID_LOG_TEST_H_
+
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <sys/types.h>
+#include <unistd.h>
+
+namespace mozc {
+namespace ipc_test {
+
+inline void MaybeLogAuthenticatedPeerPid(pid_t peer_pid,
+                                         bool expected_server_path_present) {
+#if defined(MOZC_TEST_AUTHENTICATED_PEER_PID)
+  const int saved_errno = errno;
+  if (peer_pid > 0 && expected_server_path_present) {
+    const char *expected_emitter_pid =
+        std::getenv("MOZC_TEST_FCITX_EMITTER_PID");
+    if (expected_emitter_pid != nullptr &&
+        std::to_string(static_cast<long>(::getpid())) == expected_emitter_pid) {
+      std::fprintf(stderr, "MOZC_TEST_AUTHENTICATED_UNIX_PEER_PID=%ld\n",
+                   static_cast<long>(peer_pid));
+    }
+  }
+  errno = saved_errno;
+#else
+  (void)peer_pid;
+  (void)expected_server_path_present;
+#endif
+}
+
+}  // namespace ipc_test
+}  // namespace mozc
+
+#endif  // MOZC_IPC_PEER_PID_LOG_TEST_H_
